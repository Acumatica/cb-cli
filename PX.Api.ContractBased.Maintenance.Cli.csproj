<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PX.Api.ContractBased.Maintenance.Cli</RootNamespace>
    <AssemblyName>cb-cli</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- SorterTest is a separate sibling project living under this project's directory;
         SDK-style globbing would otherwise pull its files into this project too. -->
    <Compile Remove="SorterTest\**" />
    <EmbeddedResource Remove="SorterTest\**" />
    <None Remove="SorterTest\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Utils\Sorter.cs is internal; SorterTest needs access to unit test it. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SorterTest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.0.275-beta" />
    <PackageReference Include="Acumatica.RESTClient.MaintenanceApi" Version="5.6.2-beta" />
  </ItemGroup>

</Project>
